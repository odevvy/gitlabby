#!/usr/bin/env bash
# Data helper for the Omarchy GitLab Board widget. Prints one JSON object.
# Auth stays in glab's own store; this script never reads, prints, or stores a
# token, and never prints glab's stderr.
#
# Reads (GET only, through get()):
#   board-fetch [board] --project P [--board ID]    columns of a board (default),
#                                                   also saved to the cache below; cards
#                                                   in a Review column carry the head
#                                                   pipeline of their merge request
#   board-fetch cached --project P [--board ID]     that saved copy; no glab call
#   board-fetch projects                            projects you are a member of (up to 500)
#   board-fetch boards --project P                  boards of a project
#   board-fetch issue --project P --iid N           one issue with its description
#   board-fetch notes --project P --iid N           its comments (newest 100), oldest first
#   board-fetch whoami                              your GitLab username (never saved)
#   board-fetch mrs [--project P]                   open merge requests waiting on your
#                                                   review (no drafts) and your own, 10
#                                                   each, newest change first, with each
#                                                   one's pipeline and reviewers' state;
#                                                   all projects, or only P
#   board-fetch labels --project P                  the project's labels a person may edit:
#                                                   every label but the status ones (below)
#   board-fetch access --project P                  your access level on P (the higher of
#                                                   project and group membership, 0 for
#                                                   none) and, when GitLab says, the scopes
#                                                   of the token glab signs in with (never
#                                                   the token itself)
# The four writes, each in its own function and branch:
#   board-fetch move --project P --board ID --iid N --from L --to L   (PUT, write_issue())
#     L is open, closed, or the numeric id of a label list on that board. Label
#     names come from GitLab's own copy of the board, never from the caller.
#     If the issue is no longer in --from on GitLab, nothing is written: state "stale".
#   board-fetch comment --project P --iid N <body   (POST, write_note())
#     The comment is read from stdin and never appears on a command line. A line
#     starting with / is refused: GitLab would run it as a quick action (/close,
#     /label, /move ...), which no button here may do.
#   board-fetch relabel --project P --iid N (--add L | --remove L)   (PUT, write_labels())
#     One label at a time, through add_labels/remove_labels, so no other label is
#     touched. Status labels are refused: every list label of every board in the
#     project and, best effort, of its group and parent groups' boards, plus the
#     workflow labels (research, todo, approved, in progress, review), in any case. They change only by dragging a card. --add takes only
#     a label the project already has, so a typo never creates one.
#   board-fetch close|reopen --project P --iid N   (PUT, write_state())
#     One state_event (close or reopen) and nothing else: labels stay as they
#     are. The answer must be that issue, in the new state.
#   board-fetch bulk --project P   bulk actions: one process for a whole run.
#     Reads one card per stdin line, a JSON array of the arguments of move,
#     relabel, close or reopen for P (anything else is refused for that card),
#     runs it as that command would, with its own deadline, and prints its
#     answer as one line. Ends at end of input or after 60 s without a line.
#     The sign-in check runs once, and a relabel run reads the status lists
#     and the project's labels once, not once per card.
#   board-fetch logout   glab auth logout for the host (glab's own local change: it
#     forgets the token, GitLab is not called), then deletes the saved boards.
#
# Every command ends within one deadline (40 s; BOARD_FETCH_DEADLINE, 10-120),
# and a write starts only with 15 s of it left (else "nothing was written"), so
# the widget's 50 s watchdogs never give up on a command that may still write.
#
# P is a project path (group/name) or numeric id; every command but projects,
# whoami, mrs and logout needs one. --hostname defaults to gitlab.com.
# Before any GitLab call: state "no-glab" if glab is missing, "logged-out" if
# glab has no login for the host (or GitLab refuses it).
set -uo pipefail

cmd=board project="" board_id="" iid="" from="" to="" add="" remove="" hostname="gitlab.com"
case "${1:-}" in board|cached|projects|boards|issue|notes|move|comment|whoami|mrs|logout|labels|relabel|close|reopen|access|bulk) cmd=$1; shift ;; esac
parse_args() {
while (($#)); do
  case "$1" in
    --project) project=${2:-} ;;
    --board) board_id=${2:-} ;;
    --iid) iid=${2:-} ;;
    --from) from=${2:-} ;;
    --to) to=${2:-} ;;
    --add) add=${2:-} ;;
    --remove) remove=${2:-} ;;
    --hostname) hostname=${2:-} ;;
  esac
  shift $(($# >= 2 ? 2 : 1))
done
}
parse_args "$@"

deadline_s=${BOARD_FETCH_DEADLINE:-40}
[[ $deadline_s =~ ^[0-9]+$ ]] && ((deadline_s >= 10 && deadline_s <= 120)) || deadline_s=40
deadline=$((SECONDS + deadline_s)) write_room=15
exec 3>&1  # emit writes here, so it also works inside get() while stdout goes to a file
emit() { # state message
  jq -cn --arg s "$1" --arg m "$2" '{state:$s,message:$m,updatedAt:(now|todateiso8601)}' >&3
  exit 0
}
command -v jq >/dev/null 2>&1 || { printf '%s\n' '{"state":"error","message":"jq is required."}'; exit 0; }

if [[ ! $cmd =~ ^(projects|whoami|logout)$ && ($cmd != mrs || -n $project) ]]; then
  [[ -n $project ]] || emit error "No project given: pass --project group/name."
  [[ $project =~ ^[0-9]+$ || ($project =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$ && $project != *..*) ]] ||
    emit error "Invalid project: $project"
fi
check_args() {
[[ $board_id =~ ^[0-9]*$ ]] || emit error "Invalid board id."
[[ ! $cmd =~ ^(issue|notes|move|comment|relabel|close|reopen)$ || $iid =~ ^[1-9][0-9]*$ ]] || emit error "Invalid issue number."
if [[ $cmd == move ]]; then
  [[ $board_id =~ ^[1-9][0-9]*$ ]] || emit error "Moving needs a board id."
  [[ $from =~ ^(open|closed|[1-9][0-9]*)$ && $to =~ ^(open|closed|[1-9][0-9]*)$ ]] || emit error "Invalid list."
  [[ $from != "$to" ]] || emit error "Already in that list."
fi
if [[ $cmd == relabel ]]; then
  [[ -n $add$remove && (-z $add || -z $remove) ]] || emit error "Give one label: --add or --remove."
  # No comma (GitLab would read two labels), no control characters, 1-255 chars.
  jq -en --arg l "$add$remove" '$l | test("^[^,\\p{Cc}]{1,255}$")' >/dev/null || emit error "Unsupported label name."
fi
if [[ $cmd == comment ]]; then
  # Read before any glab call; jq builds the JSON body, so the text stays off argv.
  note=$(jq -Rsc '{body: .}') || emit error "Could not read the comment."
  jq -e '.body | test("\\S")' <<<"$note" >/dev/null || emit error "Comment is empty."
  ! jq -e '.body | test("(^|[\r\n])[ \t]*/")' <<<"$note" >/dev/null ||
    emit error "A line starts with /, which GitLab runs as a quick action. Wrap it in \`backticks\` or use GitLab for quick actions."
fi
[[ $hostname =~ ^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$ ]] || emit error "Invalid GitLab hostname."
}
check_args

# The last board answer per project, board and account, shown while a fresh
# one loads. It holds the same JSON the widget gets (no auth data); dir 0700,
# file 0600. The account is the username glab saved at login (glab config get
# user: a local read, no GitLab call, never the token), so signing glab in as
# someone else never shows the other account's saved board.
cache_root=${XDG_CACHE_HOME:-}
[[ $cache_root == /* ]] || cache_root=${HOME:+$HOME/.cache}
cache_dir=$cache_root/odevvy.gitlab-board
cache_base=$cache_dir/$(jq -rn --arg p "$project" '$p | @uri')-${board_id:-first}
cache_file() {
  local account=""
  IFS= read -r account < <(timeout 5 glab config get user --host "$hostname" 2>/dev/null)
  [[ $account =~ ^[A-Za-z0-9_.-]{1,255}$ ]] || account=unknown
  printf '%s@%s.json' "$cache_base" "$account"
}
if [[ $cmd == cached ]]; then
  # Marked cached: true. A missing, unreadable or foreign file gives state "none".
  jq -cse --arg p "$project" '.[0] | select(.state == "ready" and .project == $p and (.columns | type) == "array")
    | .cached = true' "$(cache_file)" 2>/dev/null || printf '%s\n' '{"state":"none"}'
  exit 0
fi
command -v glab >/dev/null 2>&1 || emit no-glab "The GitLab CLI (glab) is not installed."
# Answers wait in a private dir, in the per-user runtime dir (a tmpfs that
# logout clears) when there is one, and go when board-fetch ends, also when it
# is stopped (bash runs the EXIT trap on TERM, HUP and INT too).
runtime=${XDG_RUNTIME_DIR:-}
[[ $runtime == /* && -d $runtime && -w $runtime ]] || runtime=${TMPDIR:-/tmp}
tmp=$(mktemp -d -p "$runtime" board-fetch.XXXXXX) || emit error "Could not create a temporary directory."
trap 'rm -rf "$tmp"' EXIT
# Every glab call ends within 30 s (exit 124), so a hung one can't hold the widget.
slow="GitLab did not answer within 30 seconds."
# 137: glab ignored the TERM and was killed 5 s later; that is a timeout too.
# glab's stderr is discarded, except where errors= names a file for it. No call
# runs past the deadline: each gets at most what is left of it.
bounded() {
  local left=$((deadline - SECONDS))
  ((left <= 30)) || left=30
  ((left >= 1)) || return 124
  { timeout -k 5 "$left" glab "$@"; } 2>"${errors:-/dev/null}"  # braces: bash's "Killed" notice goes there too
  local rc=$?
  ((rc == 137)) && rc=124
  return $rc
}
# Up to v0.1.58 a passed sign-in check left a mark (the time only) in the
# private runtime dir; none is written now, and signing out or a failed read
# removes one an older version left.
auth_mark=""
[[ $runtime == "${XDG_RUNTIME_DIR:-}" ]] && auth_mark=$runtime/odevvy.gitlab-board-auth-$hostname
forget_auth() { [[ -z $auth_mark ]] || rm -f "$auth_mark" 2>/dev/null; }
# Sign out: glab drops the host's token from its config and keyring. glab
# auth logout never prompts (--hostname is required); it works offline. Then the
# saved boards go, so a signed-out machine keeps no board data.
if [[ $cmd == logout ]]; then
  forget_auth
  bounded auth logout --hostname "$hostname" >/dev/null || emit error "glab could not sign out of $hostname."
  [[ -z $cache_root ]] || rm -rf -- "$cache_dir" 2>/dev/null || emit error "Signed out, but the saved boards in $cache_dir could not be deleted."
  emit logged-out "Signed out of $hostname."
fi
# Signed in? glab's own read-only check. Its messages are only matched here,
# never printed: no login for this host ("... authenticated with glab"), or
# GitLab refusing the token (glab's "API call failed: GET <url>: 401 ..."; a
# 401 anywhere else, say in a host name, doesn't count), means signing in again helps. Anything else
# (offline, GitLab down) is an error, so a network blip never asks for a login.
# glab auth status asks GitLab (GET /user), so it runs only after a read
# failed: a signed-out or refused read is then told apart from a network error.
check_auth() {
  errors=$tmp/auth bounded auth status --hostname "$hostname" >/dev/null
  case $? in
    0) ;;
    124) emit error "$slow" ;;
    *) grep -qE 'authenticated with glab|API call failed: .*: 401( |$)' "$tmp/auth" &&
         emit logged-out "Not signed in to $hostname. Run: glab auth login"
       emit error "Could not check your GitLab sign-in. Check your connection and try again." ;;
  esac
}
# Reads are lazy: no check before the first one (one round trip less per
# refresh); a failed read runs it. Writes check first, every time, so nothing
# is ever sent while signed out.
case $cmd in
  move|relabel|close|reopen|comment|bulk) auth_skipped=0; check_auth ;;
  *) auth_skipped=1 ;;
esac
# Every read goes through get(), which is GET by construction.
get() {
  bounded api --hostname "$hostname" --method GET "$@"
  local rc=$?
  ((rc != 124)) || emit error "$slow"
  if ((rc != 0 && auth_skipped)); then auth_skipped=0; forget_auth; check_auth; fi
  return $rc
}
base="projects/$(jq -rn --arg p "$project" '$p | @uri')"
# Before each write: enough of the deadline left for it, or nothing is sent.
room() { ((deadline - SECONDS >= write_room)) || emit error "GitLab is answering slowly. Nothing was written; try again."; }
# peek() is GET by construction like get(), but never emits: for best-effort
# extras (pipelines, reviewers) whose failure must not fail the answer.
peek() { bounded api --hostname "$hostname" --method GET "$@"; }

# jq helpers shared by the programs below.
read -r -d '' DEFS <<'JQ'
# Label names, whether GitLab sent names or label objects (with_labels_details).
def names: [(.labels // [])[] | if type == "object" then .name else . end | strings];
# Avatars and issue links only over https: nothing loads in the clear, and no
# file:, javascript: or --flag value ever reaches the browser.
def https: if type == "string" and test("^https://") then . else "" end;
# GitLab's error message for a failed write: one line, anything token-shaped redacted.
def hex: if type == "string" and test("^#[0-9A-Fa-f]{6}$") then . else null end;
# The workflow labels, furthest along first: the columns of a project with no
# board, and always status labels. Logic.js workflowLabels is the same list.
def workflow: ["review", "in progress", "approved", "todo", "research"];
# Status labels: the list labels of every board in $boards (pages of GET boards)
# plus the workflow labels, lowercased.
def status($boards): [($boards | add // [])[] | (.lists // [])[] | .label.name // empty
  | strings] + workflow | map(ascii_downcase) | unique;
# A head_pipeline object as {status, url}: GitLab's status in five words, the
# link only if https. Anything else (skipped, manual, no pipeline) is null.
def pipeline: if type == "object" then
    ({success: "passed", failed: "failed", running: "running", canceling: "running",
      pending: "pending", created: "pending", waiting_for_resource: "pending", preparing: "pending",
      scheduled: "pending", canceled: "canceled"}[.status | strings] // null) as $s
    | if $s then {status: $s, url: (.web_url | https)} else null end
  else null end;
def reason: (.message // .error // empty) | (if type == "string" then . else tojson end)
  | gsub("\\p{Cc}"; "") | gsub("(gl[a-z]{2,6}-|[Bb]earer +)[A-Za-z0-9_.=-]+"; "[redacted]") | .[0:120];
JQ

# --- merge requests (the Merge requests view) ----------------------------------
# Two GETs of the merge request list (all projects, or $base's), then for each
# row, four at a time and best effort like the Review pipelines below: one GET
# of the merge request (its head_pipeline and a fresh merge status) and one of
# its reviewers (each one's review state). A failed or slow one leaves that row
# as the list had it: no pipeline, reviewers without a state.
# First one GraphQL query (a read: "query", never "mutation"; the project goes
# in as a variable) for both lists with each MR's pipeline, merge status and
# reviewer states. Its answer is turned into the REST shapes below, so the rows
# come out the same. A reviewer state outside GitLab's MergeRequestReviewState
# (APPROVED, REQUESTED_CHANGES, REVIEWED, REVIEW_STARTED, UNAPPROVED,
# UNREVIEWED) sends that MR to the REST GETs; any GraphQL error, timeout or
# unexpected answer sends the whole view to REST.
MR_FIELDS='nodes { projectId iid title webUrl draft reference(full: true) sourceBranch updatedAt detailedMergeStatus author { username name avatarUrl } headPipeline { status path } reviewers(first: 20) { nodes { username name avatarUrl mergeRequestInteraction { reviewState } } } }'
mrs_graphql() { # writes $tmp/mrs-review, $tmp/mrs-mine, $tmp/mrd, $tmp/mrr.all and $tmp/mrs-redo, or fails
  local vars="" arg="" q
  # shellcheck disable=SC2016  # GraphQL variables, not shell ones
  if [[ $project =~ ^[1-9][0-9]*$ ]]; then vars='($id: ProjectID)' arg='projectId: $id, '
  elif [[ -n $project ]]; then vars='($p: String)' arg='projectPath: $p, '; fi
  q="query$vars { currentUser { review: reviewRequestedMergeRequests(${arg}state: opened, draft: false, sort: UPDATED_DESC, first: 10) { $MR_FIELDS } mine: authoredMergeRequests(${arg}state: opened, sort: UPDATED_DESC, first: 10) { $MR_FIELDS } } }"
  local -a pv=()
  if [[ $project =~ ^[1-9][0-9]*$ ]]; then pv=(-f "id=gid://gitlab/Project/$project")
  elif [[ -n $project ]]; then pv=(-f "p=$project"); fi
  bounded api --hostname "$hostname" graphql -f "query=$q" "${pv[@]}" >"$tmp/gql" || return 1
  jq -c --arg host "$hostname" "$DEFS"'
    def abs: if type == "string" and startswith("/") then "https://\($host)\(.)" else . end;
    def user: if type == "object" then {username, name, avatar_url: (.avatarUrl | abs)} else {} end;
    def key: "\(.projectId)/\(.iid)";
    def known: IN("APPROVED", "REQUESTED_CHANGES", "REVIEWED", "REVIEW_STARTED", "UNAPPROVED", "UNREVIEWED");
    def row: {project_id: .projectId, iid: (.iid | tonumber), title, web_url: .webUrl, draft, references: {full: .reference},
              source_branch: .sourceBranch, updated_at: .updatedAt, detailed_merge_status: (.detailedMergeStatus | strings | ascii_downcase),
              author: (.author | user), reviewers: [(.reviewers.nodes // [])[] | user]};
    def ok: all((.reviewers.nodes // [])[]; .mergeRequestInteraction.reviewState | type == "string" and known);
    select((.errors // null) == null) | .data.currentUser
    | select(type == "object" and (.review.nodes | type) == "array" and (.mine.nodes | type) == "array")
    | ([.review.nodes[], .mine.nodes[]] | unique_by(key)) as $all
    | {review: [.review.nodes[] | row], mine: [.mine.nodes[] | row],
       mrd: ([$all[] | select(ok) | {(key): {project_id: .projectId, iid: (.iid | tonumber),
              detailed_merge_status: (.detailedMergeStatus | strings | ascii_downcase),
              head_pipeline: (.headPipeline | if type == "object" then {status: (.status | strings | ascii_downcase), web_url: (.path | abs)} else null end)}}] | add // {}),
       mrr: ([$all[] | select(ok) | {(key): [(.reviewers.nodes // [])[] | {user: user, state: (.mergeRequestInteraction.reviewState | ascii_downcase)}]}] | add // {}),
       redo: [$all[] | select(ok | not) | "\(.projectId) \(.iid)"]}' "$tmp/gql" >"$tmp/gql.conv" 2>/dev/null && [[ -s $tmp/gql.conv ]] || return 1
  jq -c '.review' "$tmp/gql.conv" >"$tmp/mrs-review" && jq -c '.mine' "$tmp/gql.conv" >"$tmp/mrs-mine" &&
    jq -c '.mrd' "$tmp/gql.conv" >"$tmp/mrd" && jq -c '.mrr' "$tmp/gql.conv" >"$tmp/mrr.all" &&
    jq -r '.redo[]' "$tmp/gql.conv" >"$tmp/mrs-redo"
}
mrs_list() {
  local prefix="" kind pid miid
  [[ -z $project ]] || prefix="$base/"
  local q="state=opened&order_by=updated_at&sort=desc&per_page=20"
  if ! mrs_graphql; then
    get "${prefix}merge_requests?scope=reviews_for_me&draft=false&$q" >"$tmp/mrs-review" || emit error "Could not load merge requests."
    get "${prefix}merge_requests?scope=created_by_me&$q" >"$tmp/mrs-mine" || emit error "Could not load merge requests."
    jq -se 'length == 2 and all(type == "array")' "$tmp/mrs-review" "$tmp/mrs-mine" >/dev/null 2>&1 ||
      emit error "GitLab returned an unreadable response."
    echo '{}' >"$tmp/mrd"; echo '{}' >"$tmp/mrr.all"
    jq -rn --slurpfile r "$tmp/mrs-review" --slurpfile m "$tmp/mrs-mine" \
      '[($r[0] | map(select(.draft != true)) | .[:10][]), ($m[0][:10][])] | unique_by([.project_id, .iid])[] | "\(.project_id) \(.iid)"' >"$tmp/mrs-redo" 2>/dev/null
  fi
  mr_detail() { # project_id iid
    peek "projects/$1/merge_requests/$2" >"$tmp/mrd-$1-$2" || rm -f "$tmp/mrd-$1-$2"
    peek "projects/$1/merge_requests/$2/reviewers" >"$tmp/mrr-$1-$2" || rm -f "$tmp/mrr-$1-$2"
    return 0
  }
  # The REST GETs: every row (REST), or only the MRs GraphQL couldn't answer.
  while read -r pid miid; do
    [[ $pid =~ ^[1-9][0-9]*$ && $miid =~ ^[1-9][0-9]*$ ]] || continue
    while (($(jobs -rp | wc -l) >= 4)); do wait -n; done
    mr_detail "$pid" "$miid" &
  done <"$tmp/mrs-redo"
  wait
  local -a details=("$tmp"/mrd-*); [[ -e ${details[0]} ]] || details=()
  jq -cs --slurpfile had "$tmp/mrd" '$had[0] + (map(objects | select(.project_id and .iid) | {("\(.project_id)/\(.iid)"): .}) | add // {})' "${details[@]}" </dev/null >"$tmp/mrd.all" 2>/dev/null &&
    mv -f "$tmp/mrd.all" "$tmp/mrd" || echo '{}' >"$tmp/mrd"
  : >"$tmp/mrr"
  for f in "$tmp"/mrr-*; do
    [[ -e $f ]] || continue
    kind=${f##*/mrr-}
    jq -c --arg k "${kind/-//}" 'select(type == "array") | {($k): .}' "$f" >>"$tmp/mrr" 2>/dev/null
  done
  jq -cs --slurpfile had "$tmp/mrr.all" '$had[0] + (add // {})' "$tmp/mrr" >"$tmp/mrr.new" 2>/dev/null && mv -f "$tmp/mrr.new" "$tmp/mrr.all" || echo '{}' >"$tmp/mrr.all"
  jq -cn --slurpfile r "$tmp/mrs-review" --slurpfile m "$tmp/mrs-mine" --slurpfile d "$tmp/mrd" --slurpfile v "$tmp/mrr.all" \
    --arg scope "${project:-all}" "$DEFS"'
    def person: {username: (.username // ""), name: (.name // .username // ""), avatar: (.avatar_url | https)};
    def states: ["unreviewed", "review_started", "reviewed", "requested_changes", "approved", "unapproved"];
    def row: ("\(.project_id)/\(.iid)") as $k | ($d[0][$k] // {}) as $one | ($v[0][$k]) as $revs
      | (.references.full // "" | strings) as $full
      | {iid, title: (.title // ""), url: (.web_url | https), draft: (.draft == true),
         project: ($full | capture("^(?<p>.+)!\\d+$").p // ""),
         branch: (.source_branch // ""), updatedAt: .updated_at,
         status: (($one.detailed_merge_status // .detailed_merge_status) | strings // ""),
         author: (.author // {} | person),
         pipeline: ($one.head_pipeline | pipeline),
         reviewers: (if $revs then [$revs[] | objects | (.user // {} | person) + {state: (.state | select(IN(states[])) // null)}]
                     else [(.reviewers // [])[] | person + {state: null}] end)};
    {state: "ready", message: "", scope: $scope, updatedAt: (now | todateiso8601),
     review: [$r[0] | map(select(.draft != true))[:10][] | row], mine: [$m[0][:10][] | row]}' 2>/dev/null ||
    emit error "GitLab returned an unreadable response."
}
# The boards whose list labels are status labels, into $tmp/b (one JSON array
# per page): the project's, all pages, and, best effort, its group's and every
# parent group's (group boards show this project's issues too). A group whose
# boards can't be read adds nothing; a user namespace has none.
in_bulk=0
guard_boards() {
  # A bulk run reads them once: the first card's copy serves the rest.
  if ((in_bulk)) && [[ -f $tmp/guard-b ]]; then cp "$tmp/guard-b" "$tmp/b"; return 0; fi
  get --paginate "$base/boards?per_page=100" >"$tmp/b" || emit error "Could not load boards for $project."
  local group
  peek "$base" >"$tmp/proj" || : >"$tmp/proj"  # unreadable: no group boards
  while IFS= read -r group; do
    peek "groups/$(jq -rn --arg g "$group" '$g | @uri')/boards?per_page=100" >"$tmp/gb" &&
      jq -e 'type == "array"' "$tmp/gb" >/dev/null 2>&1 && cat "$tmp/gb" >>"$tmp/b"
  done < <(jq -r 'select(.namespace.kind == "group") | .namespace.full_path | strings | split("/") as $p
    | range($p | length; 0; -1) as $n | $p[:$n] | join("/")' "$tmp/proj" 2>/dev/null)
  ((in_bulk)) && cp "$tmp/b" "$tmp/guard-b"
  return 0
}


run_cmd() {
case $cmd in
  projects)
    # Page by page, at most 5 pages (500 projects, most recently active first),
    # so a huge membership can't keep the widget waiting for long.
    : >"$tmp/p"
    for page in 1 2 3 4 5; do
      get "projects?membership=true&simple=true&order_by=last_activity_at&per_page=100&page=$page" >"$tmp/page" || emit error "Could not load projects."
      cat "$tmp/page" >>"$tmp/p"
      [[ $(jq 'if type == "array" then length else 0 end' "$tmp/page" 2>/dev/null) == 100 ]] || break
    done
    jq -cs '{state: "ready", message: "", projects: (reduce (add // [])[] as $p ([]; if any(.[]; .id == $p.id) then . else . + [{id: $p.id, path: $p.path_with_namespace}] end))}' "$tmp/p" 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    exit 0 ;;
  whoami)
    get user >"$tmp/u" || emit error "Could not load your GitLab account."
    jq -ce 'if (.username | type) == "string" then {state: "ready", message: "", user: .username} else null end' "$tmp/u" 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    exit 0 ;;
  mrs)
    mrs_list
    exit 0 ;;
  access)
    # The project (GET, not simple: only the full answer has permissions) and,
    # best effort, the token's own record: only its scopes are kept. OAuth
    # sign-ins have no such record (404), so scopes is then null.
    get "$base" >"$tmp/a" || emit error "Could not load $project."
    peek personal_access_tokens/self >"$tmp/t" 2>/dev/null || : >"$tmp/t"
    jq -cn --slurpfile a "$tmp/a" --slurpfile t "$tmp/t" --arg p "$project" '
      ($a[0] // null) as $proj | ($t[0] // null) as $tok
      | if ($proj | type) != "object" or ($proj.id | type) != "number" then null else
        {state: "ready", message: "", project: $p,
         level: ([$proj.permissions.project_access.access_level?, $proj.permissions.group_access.access_level?] | map(numbers) | max // 0),
         scopes: (if ($tok | type) == "object" and ($tok.scopes | type) == "array"
           then [$tok.scopes[] | strings | select(test("^[a-z_]{1,40}$"))] else null end)} end' 2>/dev/null |
      grep -v '^null$' | grep . || emit error "GitLab returned an unreadable response."
    exit 0 ;;
  labels)
    guard_boards
    get --paginate "$base/labels?per_page=100" >"$tmp/l" || emit error "Could not load labels for $project."
    jq -cn --slurpfile b "$tmp/b" --slurpfile l "$tmp/l" "$DEFS"' status($b) as $status
      | {state: "ready", message: "", status: $status,
         labels: [($l | add // [])[] | select((.name | type) == "string" and (.name | ascii_downcase | IN($status[]) | not))
           | {name, color: (.color | hex), textColor: (.text_color | hex)}] | unique_by(.name) | sort_by(.name | ascii_downcase)}' 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    exit 0 ;;
  relabel)
    label=$add$remove
    guard_boards
    kind=$(jq -rn --slurpfile b "$tmp/b" --arg l "$label" "$DEFS"' if $l | ascii_downcase | IN(status($b)[]) then "status" else "free" end' 2>/dev/null)
    [[ $kind == free ]] || emit error "$([[ $kind == status ]] && echo "\"$label\" is a board list label. Drag the card to change it." ||
      echo "GitLab returned an unreadable response.")"
    if [[ -n $add ]]; then
      if ((in_bulk)) && [[ -f $tmp/guard-l ]]; then cp "$tmp/guard-l" "$tmp/l"
      else get --paginate "$base/labels?per_page=100" >"$tmp/l" || emit error "Could not load labels for $project."; fi
      known=$(jq -rn --slurpfile all "$tmp/l" --arg l "$label" '[($all | add // [])[] | .name] | index($l) != null' 2>/dev/null)
      ((in_bulk)) && cp "$tmp/l" "$tmp/guard-l"
      [[ $known == true ]] || emit error "$([[ $known == false ]] && echo "This project has no label \"$label\"." ||
        echo "GitLab returned an unreadable response.")"
    fi
    # PUT like write_issue(): the JSON body on stdin, never on the command line.
    write_labels() {
      bounded api --hostname "$hostname" --method PUT --header "Content-Type: application/json" --input - "$base/issues/$iid"
    }
    room
    jq -cn --arg a "$add" --arg r "$remove" 'if $a != "" then {add_labels: $a} else {remove_labels: $r} end' | write_labels >"$tmp/r"
    case $? in
      0) ;;
      124) emit error "GitLab did not answer within 30 seconds. The label change may have gone through." ;;
      *) reason=$(jq -r "$DEFS reason" "$tmp/r" 2>/dev/null)
         emit error "Label change failed${reason:+: $reason}" ;;
    esac
    jq -c --argjson iid "$iid" --arg a "$add" --arg r "$remove" "$DEFS"' select(type == "object" and .iid == $iid)
      | {state: "ready", message: (if $a != "" then "Added \($a)." else "Removed \($r)." end), labels: names,
         updatedAt: (now | todateiso8601)}' "$tmp/r" 2>/dev/null |
      grep . || emit error "GitLab returned an unexpected response to the label change."
    exit 0 ;;
  close|reopen)
    # A PUT like write_issue(): the JSON body on stdin, only a state_event.
    write_state() {
      bounded api --hostname "$hostname" --method PUT --header "Content-Type: application/json" --input - "$base/issues/$iid"
    }
    if [[ $cmd == close ]]; then want=closed done_=closed doing=Closing; else want=opened done_=reopened doing=Reopening; fi
    room
    jq -cn --arg e "$cmd" '{state_event: $e}' | write_state >"$tmp/r"
    case $? in
      0) ;;
      124) emit error "GitLab did not answer within 30 seconds. The issue may have been $done_." ;;
      *) reason=$(jq -r "$DEFS reason" "$tmp/r" 2>/dev/null)
         emit error "$doing failed${reason:+: $reason}" ;;
    esac
    jq -c --argjson iid "$iid" --arg want "$want" "$DEFS"' select(type == "object" and .iid == $iid and .state == $want)
      | {state: "ready", message: (if $want == "closed" then "Closed #\($iid)." else "Reopened #\($iid)." end), issueState: .state,
         labels: names, updatedAt: (now | todateiso8601)}' "$tmp/r" 2>/dev/null |
      grep . || emit error "GitLab returned an unexpected response."
    exit 0 ;;
  boards)
    get --paginate "$base/boards?per_page=100" >"$tmp/b" || emit error "Could not load boards for $project."
    jq -cs '{state: "ready", message: "", boards: [add // [] | .[] | {id, name}]}' "$tmp/b" 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    exit 0 ;;
  issue)
    get "$base/issues/$iid" >"$tmp/i" || emit error "Could not load issue #$iid."
    jq -c "$DEFS"' {state: "ready", message: "", issue: {iid, title, state, labels: (.labels // []), url: (.web_url | https),
      description: (.description // ""), author: (.author.username // ""), milestone: (.milestone.title // ""),
      assignees: [(.assignees // [])[].username], createdAt: .created_at, updatedAt: .updated_at}}' "$tmp/i" 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    exit 0 ;;
  notes)
    # Newest 100 notes (GitLab's page maximum); comments only, oldest first.
    get "$base/issues/$iid/notes?sort=desc&order_by=created_at&per_page=100" >"$tmp/n" || emit error "Could not load comments."
    jq -c --argjson iid "$iid" "$DEFS"' select(type == "array") | {state: "ready", message: "", iid: $iid, more: (length >= 100),
      notes: [reverse[] | select(.system != true) | {id, body: (.body // ""), createdAt: .created_at,
        author: {username: (.author.username // ""), name: (.author.name // .author.username // ""), avatar: (.author.avatar_url | https)}}]}' "$tmp/n" 2>/dev/null |
      grep . || emit error "GitLab returned an unreadable response."
    exit 0 ;;
  comment)
    # The only POST in this script, the same way as write_issue(): JSON on stdin.
    write_note() {
      bounded api --hostname "$hostname" --method POST --header "Content-Type: application/json" --input - "$base/issues/$iid/notes"
    }
    room
    printf '%s' "$note" | write_note >"$tmp/r"
    case $? in
      0) ;;
      124) emit timeout "GitLab did not answer within 30 seconds. The comment may have been posted." ;;
      *) reason=$(jq -r "$DEFS reason" "$tmp/r" 2>/dev/null)
         emit error "Comment failed${reason:+: $reason}" ;;
    esac
    jq -c 'select(type == "object" and (.id | type) == "number")
      | {state: "ready", message: "Comment posted.", updatedAt: (now | todateiso8601), note: {id}}' "$tmp/r" 2>/dev/null |
      grep . && exit 0
    # Defence: GitLab answers a comment made only of quick actions with what they
    # changed and no note. Nothing above sends one, but if it happens, say so.
    jq -e 'type == "object" and (has("commands_changes") or has("summary"))' "$tmp/r" >/dev/null 2>&1 &&
      emit commands "GitLab ran this as quick actions instead of posting a comment. Check the issue."
    emit error "GitLab returned an unexpected response to the comment." ;;  # emit exits
  move)
    # Both lists are looked up in GitLab's own copy of the board (a GET), so the
    # labels sent below are that board's list labels and nothing else.
    # Effects follow GitLab's board (docs.gitlab.com/user/project/issue_board/
    # #dragging-issues-between-lists): label A -> label B swaps the two labels,
    # -> Closed closes (labels kept), Closed -> anywhere reopens, -> Open drops
    # the source label. Assignee, milestone and other lists are refused.
    # The issue is read fresh too: a card can be out of date, and moving from a
    # list the issue has already left could leave two list labels on it.
    get "$base/boards/$board_id" >"$tmp/b" || emit error "Could not load board $board_id."
    get "$base/issues/$iid" >"$tmp/i" || emit error "Could not load issue #$iid."
    read -r -d '' PLAN <<'JQ'
def list($spec):
  if $spec == "open" then (if .hide_backlog_list then {err: "This board has no Open list."} else {kind: "open", name: "Open"} end)
  elif $spec == "closed" then (if .hide_closed_list then {err: "This board has no Closed list."} else {kind: "closed", name: "Closed"} end)
  else ([(.lists // [])[] | select((.id | tostring) == $spec)][0]
    | if . == null then {err: "That list is not on this board."}
      elif (.label.name | type) != "string" then {err: "Only label lists can be moved between."}
      elif (.label.name | test("^[^,\\p{Cc}]{1,255}$") | not) then {err: "Unsupported label name."}
      else {kind: "label", name: .label.name} end)
  end;
# Is the issue in list $l now? Same rules as the board: Closed = closed; a label
# list = open with that label; Open = open with none of the board's list labels.
def holds($l; $listLabels):
  names as $names
  | if $l.kind == "closed" then .state == "closed"
    elif .state != "opened" then false
    elif $l.kind == "label" then $names | index($l.name) != null
    else [$names[] | select(IN($listLabels[]))] == [] end;
$i[0] as $issue | [(.lists // [])[] | .label.name // empty] as $listLabels
| if type != "object" or ($issue | type) != "object" or $issue.iid != $iid then {err: "GitLab returned an unreadable response."} else
list($from) as $f | list($to) as $t
| if $f.err then {err: $f.err} elif $t.err then {err: $t.err}
  elif ($issue | holds($f; $listLabels) | not) then {stale: "#\($iid) changed on GitLab. Board refreshed."} else
    {body: ((if $f.kind == "closed" then {state_event: "reopen"} else {} end)
      + (if $t.kind == "closed" then {state_event: "close"} else {} end)
      + (if $f.kind == "label" and $t.kind != "closed" then {remove_labels: $f.name} else {} end)
      + (if $t.kind == "label" then {add_labels: $t.name} else {} end)),
     to: $t.name}
  end end
JQ
    jq -c --arg from "$from" --arg to "$to" --argjson iid "$iid" --slurpfile i "$tmp/i" "$DEFS $PLAN" "$tmp/b" >"$tmp/plan" 2>/dev/null ||
      emit error "GitLab returned an unreadable response."
    err=$(jq -r '.err // empty' "$tmp/plan")
    [[ -z $err ]] || emit error "$err"
    stale=$(jq -r '.stale // empty' "$tmp/plan")
    [[ -z $stale ]] || emit stale "$stale"
    # A PUT, like write_labels() above. The JSON body goes in on stdin
    # (--input), so glab never expands @files or :placeholders in it.
    write_issue() {
      bounded api --hostname "$hostname" --method PUT --header "Content-Type: application/json" --input - "$base/issues/$iid"
    }
    room
    jq -c '.body' "$tmp/plan" | write_issue >"$tmp/r"
    case $? in
      0) ;;
      124) emit error "GitLab did not answer within 30 seconds. The move may have gone through." ;;
      *) reason=$(jq -r "$DEFS reason" "$tmp/r" 2>/dev/null)
         emit error "Move failed${reason:+: $reason}" ;;
    esac
    jq -c --argjson iid "$iid" --slurpfile plan "$tmp/plan" 'select(type == "object" and .iid == $iid)
      | {state: "ready", message: "Moved #\(.iid) to \($plan[0].to).", updatedAt: (now | todateiso8601)}' "$tmp/r" 2>/dev/null |
      grep . || emit error "GitLab returned an unexpected response to the move."
    exit 0 ;;
esac
}
# Bulk: each stdin line is one card's command, run in a subshell (so its emit
# and exit end only that card) with its own deadline, in this process's
# private dir. The project and host stay the run's own.
bulk_step() { # one card: its stdin line
  local line=$1 args=()
  exec 3>&1
  [[ ${#line} -le 4096 ]] && mapfile -d '' args < <(jq -j 'select(type == "array" and length >= 1 and length <= 12
    and all(.[]; type == "string" and (contains("\u0000") | not))) | .[] | . + "\u0000"' <<<"$line" 2>/dev/null)
  ((${#args[@]})) || emit error "Unreadable bulk step."
  cmd=${args[0]} project="" board_id="" iid="" from="" to="" add="" remove=""
  [[ $cmd =~ ^(move|relabel|close|reopen)$ ]] || emit error "Bulk runs only move, relabel, close and reopen."
  parse_args "${args[@]:1}"
  [[ $project == "$run_project" ]] || emit error "Bulk step for another project."
  hostname=$run_host deadline=$((SECONDS + deadline_s))
  check_args
  run_cmd
}
if [[ $cmd == bulk ]]; then
  in_bulk=1 run_project=$project run_host=$hostname
  while IFS= read -r -t 60 line; do
    (bulk_step "$line") </dev/null >"$tmp/card"
    jq -c . "$tmp/card" 2>/dev/null | head -n 1 | grep . ||
      jq -cn '{state: "error", message: "board-fetch gave no answer for this card.", updatedAt: (now | todateiso8601)}'
    rm -f "$tmp/card"
  done
  exit 0
fi
run_cmd

# --- board -----------------------------------------------------------------
# One call returns every board with its lists (GET /projects/:id/boards).
get --paginate "$base/boards?per_page=100" >"$tmp/boards" || emit error "Could not load boards for $project."
jq -cs --arg want "$board_id" 'add // [] | (map(select((.id | tostring) == $want)) + .)[0] // null' \
  "$tmp/boards" >"$tmp/board" 2>/dev/null || emit error "GitLab returned an unreadable response."

# Board scope (Premium) becomes issue filters, so the columns match GitLab.
scope=$(jq -r 'if . == null then "" else [
    (if (.labels // []) | length > 0 then "labels=" + ([.labels[].name] | join(",") | @uri) else empty end),
    (if .milestone.title then "milestone=" + (.milestone.title | @uri) else empty end),
    (.assignee.id | numbers | "assignee_id=\(.)"),
    (if (.weight | type) == "number" and .weight >= 0 then "weight=\(.weight)" else empty end)
  ] | map("&" + .) | join("") end' "$tmp/board")
hide_closed=$(jq -r '.hide_closed_list // false' "$tmp/board")
# Closed shows the latest 20. One more is asked for, so "capped" means there
# really are more (shown as 20+), and a capped column links to the rest (seeAll).
closed_cap=20

# Open and closed issues load at the same time (one round trip instead of two).
# Each exit code goes to a file; after both end they are read in the old order,
# so the answers (timeout, sign-in, "Could not load ...") are the same as before.
( peek --paginate "$base/issues?state=opened&scope=all&order_by=relative_position&sort=asc&per_page=100&with_labels_details=true$scope" >"$tmp/open"
  echo $? >"$tmp/open.rc" ) &
if [[ $hide_closed == true ]]; then
  echo '[]' >"$tmp/closed"; echo 0 >"$tmp/closed.rc"
else
  ( peek "$base/issues?state=closed&scope=all&order_by=updated_at&sort=desc&per_page=$((closed_cap + 1))&with_labels_details=true$scope" >"$tmp/closed"
    echo $? >"$tmp/closed.rc" ) &
fi
wait
for part in open closed; do
  rc=$(<"$tmp/$part.rc")
  ((rc != 124)) || emit error "$slow"
  if ((rc != 0)); then
    if ((auth_skipped)); then auth_skipped=0; forget_auth; check_auth; fi
    emit error "Could not load $part issues for $project."
  fi
done

# GitLab's rules (docs.gitlab.com/user/project/issue_board/#issue-board-terminology):
# Open = open issues in no other list; a label list = open issues with that label
# (an issue with two list labels shows in both); Closed = closed issues.
# Without a board, fall back to workflow labels (furthest along wins).
# Issues come with_labels_details, so .labels are objects: their colors go into
# one labelColors map and rows keep plain label names.
read -r -d '' MAP <<'JQ'
def row: {iid, title, labels: names, url: (.web_url | https), createdAt: .created_at, notes: (.user_notes_count // 0),
  assignees: [(.assignees // [])[] | {username, name: (.name // .username), avatar: (.avatar_url | https)}]};
def has_any($names): [.labels[] | select(IN($names[]))] | length > 0;
$b[0] as $board | ($o | add // []) as $rawOpen | ($c | add // []) as $fetchedClosed
| ($fetchedClosed | length > $cap) as $capped | $fetchedClosed[:$cap] as $rawClosed
| ([($rawOpen + $rawClosed)[] | (.labels // [])[] | objects] + [($board.lists // [])[] | .label | objects]
   | map(select((.name | type) == "string" and (.color | hex)) | {(.name): {color: (.color | hex), textColor: (.text_color | hex)}})
   | add // {}) as $colors
| ($rawOpen | map(select(.state == "opened") | .labels = names)) as $open | ($rawClosed | map(.labels = names)) as $closed
# A capped Closed column links to the project's closed issues on GitLab,
# with the board's label, milestone, assignee and weight filters when it has them.
# GitLab.com now gives issues /-/work_items/<iid> web URLs; older hosts /-/issues/<iid>.
| (if $capped
   then [$rawClosed[0].web_url | https | capture("^(?<p>https://[^?#]+)/-/(?:issues|work_items)/[0-9]+$") | .p] | first else null end) as $proj
| (if $board == null then "" else
     [(($board.labels // [])[] | .name | strings | "&label_name%5B%5D=" + @uri),
      ($board.milestone.title | strings | "&milestone_title=" + @uri),
      ($board.assignee.username | strings | "&assignee_username=" + @uri),
      (if ($board.weight | type) == "number" and $board.weight >= 0 then "&weight=\($board.weight)" else empty end)] | join("") end) as $webScope
| ({name: "Closed", kind: "closed", issues: [$closed[] | row]} + (if $capped then {capped: true} else {} end)
   + (if $proj then {seeAll: ($proj + "/-/issues?state=closed" + $webScope)} else {} end))
  as $closedColumn
| {state: "ready", updatedAt: (now | todateiso8601), project: $project, labelColors: $colors,
   boards: ($all | add // [] | map({id, name})),
   board: (if $board then {id: $board.id, name: $board.name} else null end), fallback: ($board == null)}
+ if $board == null then
    workflow as $rank
    | {message: "No boards in this project: showing workflow label columns.",
       columns: ([$rank | reverse[] as $n | {name: $n, kind: "label", color: $colors[$n].color, issues: [$open[]
                   | . as $i | select(([$rank[] | select(. as $l | $i.labels | index($l))] | first) == $n) | row]}]
         + [$closedColumn]
         + [{name: "Unlabeled", kind: "open", issues: [$open[] | select(has_any($rank) | not) | row]}])}
  else
    ($board.lists // [] | sort_by(.position)) as $lists
    | [$lists[] | .label.name // empty] as $listLabels
    | {message: (if $want != "" and ($board.id | tostring) != $want then "Saved board not found: showing \($board.name)." else "" end),
       columns: (
         (if $board.hide_backlog_list then [] else
           [{name: "Open", kind: "open", issues: [$open[] | select(has_any($listLabels) | not) | row]}] end)
         + [$lists[] | if .label then
               .label.name as $l | {name: $l, kind: "label", listId: .id, color: ((.label.color | hex) // $colors[$l].color), issues: [$open[] | select(.labels | index($l)) | row]}
             else {name: (.assignee.username // .milestone.title // .iteration.title // .status.name // "List"),
                   kind: "other", note: "This list type is not supported yet.", issues: []} end]
         + (if $board.hide_closed_list then [] else [$closedColumn] end))}
  end
JQ
jq -cn --slurpfile b "$tmp/board" --slurpfile all "$tmp/boards" --slurpfile o "$tmp/open" --slurpfile c "$tmp/closed" \
  --arg want "$board_id" --arg project "$project" --argjson cap "$closed_cap" "$DEFS $MAP" >"$tmp/out" 2>/dev/null || emit error "GitLab returned an unreadable response."
# --- pipelines of Review cards -----------------------------------------------
# Each card in a column named Review (any case; at most 15 cards) gets the head
# pipeline of its merge request: one GET of issues/:iid/related_merge_requests,
# whose MRs carry head_pipeline. The open MR wins, else the latest merged one;
# closed MRs don't count. Only if GitLab left head_pipeline out, one GET of that
# MR. Best effort, eight at a time: no MR, no pipeline, no access or a timeout
# leaves the card without one, and never fails the board. peek() (above) is
# GET only and never emits: these run in the background.
# A finished pipeline (passed, failed, canceled) is reused for 2 minutes without
# asking: they are kept beside the saved board (<board file>.pipes.json, the
# same fields plus the time asked). Running and pending ones are asked each time.
pipeline_of() { # iid; writes $tmp/pipe-<iid> with {"<iid>": {status, url, mr}} or nothing
  local iid=$1 pid="" miid="" found
  peek "$base/issues/$iid/related_merge_requests" >"$tmp/rel-$iid" || return 0
  # One jq: the MR's pipeline, or "need <project> <iid>" when head_pipeline is missing.
  found=$(jq -r --arg iid "$iid" "$DEFS"' select(type == "array") | [.[] | objects | select(.state == "opened" or .state == "merged")]
    | sort_by([(.state == "opened"), (.updated_at // "")]) | last // empty
    | if has("head_pipeline") then (.head_pipeline | pipeline) as $p | select($p)
        | "pipe " + ({($iid): ($p + {mr: (.reference // "!\(.iid)" | tostring)})} | tojson)
      else "need \(.project_id) \(.iid)" end' "$tmp/rel-$iid" 2>/dev/null)
  case $found in
    "pipe "*) printf '%s\n' "${found#pipe }" >"$tmp/pipe-$iid" ;;
    "need "*)
      read -r _ pid miid <<<"$found"
      [[ $pid =~ ^[1-9][0-9]*$ && $miid =~ ^[1-9][0-9]*$ ]] || return 0
      peek "projects/$pid/merge_requests/$miid" >"$tmp/mr-$iid" || return 0
      jq -c --arg iid "$iid" "$DEFS"' select(type == "object") | (.head_pipeline | pipeline) as $p | select($p)
        | {($iid): ($p + {mr: (.reference // "!\(.iid)" | tostring)})}' "$tmp/mr-$iid" >"$tmp/pipe-$iid" 2>/dev/null ;;
  esac
  return 0
}
board_file="" pipes_file=""
if [[ -n $cache_root ]]; then board_file=$(cache_file); pipes_file=${board_file%.json}.pipes.json; fi
[[ -n $pipes_file && -f $pipes_file && ! -L $pipes_file ]] && jq -e 'type == "object"' "$pipes_file" >/dev/null 2>&1 &&
  cp "$pipes_file" "$tmp/pipes-prev" 2>/dev/null || echo '{}' >"$tmp/pipes-prev"
reused=()
while read -r what riid; do
  [[ $riid =~ ^[1-9][0-9]*$ ]] || continue
  if [[ $what == reuse ]]; then reused+=("$riid"); continue; fi
  while (($(jobs -rp | wc -l) >= 8)); do wait -n; done
  pipeline_of "$riid" &
done < <(jq -r --slurpfile prev "$tmp/pipes-prev" --argjson now "$EPOCHSECONDS" '$prev[0] as $p
  | [.columns[] | select(.kind == "label" and (.name | ascii_downcase) == "review") | .issues[].iid] | unique | .[:15][]
  | tostring as $i | ($p[$i] // null) as $c
  | if ($c | type) == "object" and ($c.status | IN("passed", "failed", "canceled"))
       and ((($c.at | numbers) // -1) as $at | $now - $at >= 0 and $now - $at < 120)
    then "reuse \($i)" else "ask \($i)" end' "$tmp/out" 2>/dev/null)
wait
# One jq: the board with each Review card's pipeline (line 1) and the pipelines
# to keep (line 2): those just asked, stamped now, and the reused ones.
pipe_files=("$tmp"/pipe-*); [[ -e ${pipe_files[0]} ]] || pipe_files=()
if ((${#pipe_files[@]} + ${#reused[@]})); then
  jq -cn --slurpfile o "$tmp/out" --slurpfile prev "$tmp/pipes-prev" --argjson now "$EPOCHSECONDS" \
    --argjson reused "$(printf '%s\n' "${reused[@]}" | jq -sc 'map(tostring)')" '
    (reduce inputs as $x ({}; . + ($x | objects))) as $fresh
    | (($prev[0] | with_entries(select(.key | IN($reused[])))) + ($fresh | map_values(. + {at: $now}))) as $all
    | ($o[0] | .columns |= map(if .kind == "label" and (.name | ascii_downcase) == "review"
        then .issues |= map(if $all[.iid | tostring] then . + {pipeline: ($all[.iid | tostring] | del(.at))} else . end) else . end)),
      $all' "${pipe_files[@]}" </dev/null >"$tmp/both" 2>/dev/null &&
    { IFS= read -r board && IFS= read -r pipes; } <"$tmp/both" && [[ -n $board && -n $pipes ]] &&
    printf '%s\n' "$board" >"$tmp/out" && printf '%s\n' "$pipes" >"$tmp/pipes-next"
fi
[[ -f $tmp/pipes-next ]] || echo '{}' >"$tmp/pipes-next"

# Best effort: write a temp file in the cache dir, then rename it over the old
# copy, so a reader never sees half a file. A failed write changes nothing.
if [[ -n $cache_root ]] && mkdir -p "$cache_dir" 2>/dev/null && chmod 700 "$cache_dir" 2>/dev/null &&
  part=$(mktemp "$cache_dir/.part.XXXXXX" 2>/dev/null); then
  { cat "$tmp/out" >"$part" && mv -f "$part" "$board_file"; } 2>/dev/null || rm -f "$part"
  # The pipelines beside it, only when there are some (or were: then emptied).
  if [[ $(<"$tmp/pipes-next") != "{}" || -e $pipes_file ]] && part=$(mktemp "$cache_dir/.part.XXXXXX" 2>/dev/null); then
    { cat "$tmp/pipes-next" >"$part" && mv -f "$part" "$pipes_file"; } 2>/dev/null || rm -f "$part"
  fi
  rm -f "$cache_base.json" 2>/dev/null  # the copy saved before accounts (0.1.40 and older)
fi
cat "$tmp/out"
