{
  "schemaVersion": 1,
  "id": "odevvy.gitlab-board",
  "name": "GitLab Board",
  "version": "0.1.1",
  "author": "o_devvy",
  "license": "MIT",
  "description": "A GitLab issue board for one project in a bar popup: research, todo, approved, in progress, review, closed.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Board.qml"
  },
  "barWidget": {
    "displayName": "GitLab Board",
    "description": "Shows a GitLab project's issues as board columns. Click an issue to open it in the browser.",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "project": "firelink21/phrase41",
      "refreshIntervalSec": 60,
      "collapsedColumns": [],
      "hiddenColumns": []
    },
    "schema": [
      {
        "key": "project",
        "type": "string",
        "label": "GitLab project",
        "description": "Full project path, e.g. group/project",
        "defaultValue": "firelink21/phrase41"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "collapsedColumns",
        "type": "multiselect",
        "label": "Collapsed columns",
        "description": "Columns shown as a narrow strip. Click a column header in the popup to toggle.",
        "noSelectionText": "None",
        "options": [
          {
            "value": "research",
            "label": "research"
          },
          {
            "value": "todo",
            "label": "todo"
          },
          {
            "value": "approved",
            "label": "approved"
          },
          {
            "value": "in progress",
            "label": "in progress"
          },
          {
            "value": "review",
            "label": "review"
          },
          {
            "value": "closed",
            "label": "closed"
          },
          {
            "value": "unlabeled",
            "label": "unlabeled"
          }
        ],
        "defaultValue": []
      },
      {
        "key": "hiddenColumns",
        "type": "multiselect",
        "label": "Hidden columns",
        "description": "Columns left out of the board. Use the chips in the popup header to toggle.",
        "noSelectionText": "None",
        "options": [
          {
            "value": "research",
            "label": "research"
          },
          {
            "value": "todo",
            "label": "todo"
          },
          {
            "value": "approved",
            "label": "approved"
          },
          {
            "value": "in progress",
            "label": "in progress"
          },
          {
            "value": "review",
            "label": "review"
          },
          {
            "value": "closed",
            "label": "closed"
          },
          {
            "value": "unlabeled",
            "label": "unlabeled"
          }
        ],
        "defaultValue": []
      }
    ]
  }
}
