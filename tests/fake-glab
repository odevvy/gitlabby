#!/usr/bin/env bash
# Test double for glab: serves JSON fixtures from $FAKE_DIR, logs every call to
# $FAKE_LOG, and prints a fake token on stderr (must never reach output).
# Any request that is not an explicit GET is logged as "NON-GET ...". The move
# write (a PUT with a JSON --input body to issues/N) is
# also logged as "PUT <endpoint> <body>" and answered from put.json, or, with
# FAKE_PUT=fail, from put-error.json with exit 1. The comment write (a POST
# with a JSON --input body to issues/N/notes) is logged as "POST <endpoint>
# <body>" and answered from post.json (FAKE_POST=fail: post-error.json, exit 1).
# Any other write fails. FAKE_AUTH: see auth status below; auth logout succeeds
# unless FAKE_LOGOUT=fail. FAKE_HANG (see tests/run.sh, T) makes a call hang.
printf '%s\n' "$*" >>"$FAKE_LOG"
if [[ -n ${FAKE_HANG:-} && " $* " == *"$FAKE_HANG"* ]]; then  # never answers
  [[ ${FAKE_HANG_TERM:-} == ignore ]] && trap '' TERM
  exec sleep 5
fi
echo "glpat-FAKEFAKEFAKEFAKEFAKE Authorization: Bearer FAKE" >&2
# auth status: FAKE_AUTH picks one of glab's real answers (its stderr, exit 1).
if [[ $1 == auth && $2 == logout ]]; then
  [[ ${FAKE_LOGOUT:-ok} == ok ]] || { echo "could not write config" >&2; exit 1; }
  echo "Successfully logged out of ${*: -1}" >&2; exit 0
fi
if [[ $1 == auth ]]; then
  case ${FAKE_AUTH:-ok} in
    ok) exit 0 ;;
    no) echo "x gitlab.com has not been authenticated with glab; run \`glab auth login --hostname gitlab.com\` to authenticate" >&2 ;;
    none) echo "no GitLab instances have been authenticated with glab; run \`glab auth login\` to authenticate" >&2 ;;
    401) echo "x gitlab.com: API call failed: GET https://gitlab.com/api/v4/user: 401 {message: 401 Unauthorized}" >&2 ;;
    offline) echo 'x gitlab.com: API call failed: Get "https://gitlab.com/api/v4/user": dial tcp: lookup gitlab.com: no such host' >&2 ;;
  esac
  exit 1
fi
endpoint=${*: -1}
if [[ " $* " != *" --method GET "* ]]; then
  echo "NON-GET $*" >>"$FAKE_LOG"
  if [[ " $* " == *" --method PUT --header Content-Type: application/json --input - "* && $endpoint =~ ^projects/[^/]+/issues/[0-9]+$ ]]; then
    printf 'PUT %s %s\n' "$endpoint" "$(cat)" >>"$FAKE_LOG"
    if [[ ${FAKE_PUT:-ok} != ok ]]; then cat "$FAKE_DIR/put-error.json" 2>/dev/null; exit 1; fi
    cat "$FAKE_DIR/put.json"; exit
  fi
  if [[ " $* " == *" --method POST --header Content-Type: application/json --input - "* && $endpoint =~ ^projects/[^/]+/issues/[0-9]+/notes$ ]]; then
    printf 'POST %s %s\n' "$endpoint" "$(cat)" >>"$FAKE_LOG"
    if [[ ${FAKE_POST:-ok} != ok ]]; then cat "$FAKE_DIR/post-error.json" 2>/dev/null; exit 1; fi
    cat "$FAKE_DIR/post.json"; exit
  fi
  echo "BAD-WRITE $*" >>"$FAKE_LOG"; exit 9
fi
case $endpoint in
  projects\?*) f=projects ;;
  */boards\?*) f=boards ;;
  */boards/[0-9]*) f=board ;;
  */issues\?state=opened*) f=open ;;
  */issues\?state=closed*) f=closed ;;
  */issues/*/notes\?*) f=notes ;;
  */issues/*) f=issue ;;
  user) f=user ;;
  *) exit 1 ;;
esac
[[ -f $FAKE_DIR/$f.json ]] || exit 1
cat "$FAKE_DIR/$f.json"
