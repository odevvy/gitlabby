#!/usr/bin/env bash
# Test double for glab: serves JSON fixtures from $FAKE_DIR, logs every call to
# $FAKE_LOG, and prints a fake token on stderr (must never reach output).
# Any request that is not an explicit GET is logged as "NON-GET ...". The move
# and relabel writes (a PUT with a JSON --input body to issues/N) are
# also logged as "PUT <endpoint> <body>" and answered from put.json, or, with
# FAKE_PUT=fail, from put-error.json with exit 1. The comment write (a POST
# with a JSON --input body to issues/N/notes) is logged as "POST <endpoint>
# <body>" and answered from post.json (FAKE_POST=fail: post-error.json, exit 1).
# Any other write fails. FAKE_AUTH: see auth status below; auth logout succeeds
# unless FAKE_LOGOUT=fail. FAKE_HANG (see tests/run.sh, T) makes a call hang.
# GraphQL: see below. Merge requests: issues/N/related_merge_requests answers related-N.json and
# projects/P/merge_requests/M answers mr-M.json; a missing file is a refusal.
# The MR lists: scope=reviews_for_me answers mrs-review.json, scope=created_by_me
# mrs-mine.json (any project prefix); .../merge_requests/M/reviewers reviewers-M.json.
# Access: projects/P (one segment) answers project.json, personal_access_tokens/self
# token-self.json. Group boards: groups/G/boards answers group-boards-G.json
# (G as sent, e.g. top%2Fsub).
printf '%s\n' "$*" >>"$FAKE_LOG"
if [[ -n ${FAKE_HANG:-} && " $* " == *"$FAKE_HANG"* ]]; then  # never answers
  [[ ${FAKE_HANG_TERM:-} == ignore ]] && trap '' TERM
  exec sleep 5
fi
echo "glpat-FAKEFAKEFAKEFAKEFAKE Authorization: Bearer FAKE" >&2
# glab config get user --host H: the account glab saved at login (FAKE_USER, default me;
# FAKE_USER=none: nothing saved).
if [[ $1 == config && $2 == get && $3 == user ]]; then
  [[ ${FAKE_USER:-me} == none ]] || printf '%s\n' "${FAKE_USER:-me}"; exit 0
fi
# auth status: FAKE_AUTH picks one of glab's real answers (its stderr, exit 1).
if [[ $1 == auth && $2 == logout ]]; then
  [[ ${FAKE_LOGOUT:-ok} == ok ]] || { echo "could not write config" >&2; exit 1; }
  echo "Successfully logged out of ${*: -1}" >&2; exit 0
fi
if [[ $1 == auth ]]; then
  case ${FAKE_AUTH:-ok} in
    ok) exit 0 ;;
    no) echo "x gitlab.com has not been authenticated with glab; run \`glab auth login --hostname gitlab.com\` to authenticate" >&2 ;;
    none) echo "no GitLab instances have been authenticated with glab; run \`glab auth login\` to authenticate" >&2 ;;
    401) echo "x gitlab.com: API call failed: GET https://gitlab.com/api/v4/user: 401 {message: 401 Unauthorized}" >&2 ;;
    offline401) echo 'x git401lab.example: API call failed: Get "https://git401lab.example/api/v4/user": dial tcp: lookup git401lab.example: no such host' >&2 ;;
    offline) echo 'x gitlab.com: API call failed: Get "https://gitlab.com/api/v4/user": dial tcp: lookup gitlab.com: no such host' >&2 ;;
  esac
  exit 1
fi
endpoint=${*: -1}
# Signed out (any FAKE_AUTH but ok): every API call fails as glab's does without
# a usable token (also offline: no answer at all). FAKE_PUBLIC=1: a public
# project, whose reads work without a login (writes are still logged as such).
if [[ ${FAKE_AUTH:-ok} != ok && $1 == api && -z ${FAKE_PUBLIC:-} ]]; then echo "glab: 401 Unauthorized" >&2; exit 1; fi
# FAKE_MR_PROBE=<dir>: related_merge_requests calls take 0.3 s, and each logs how many
# were running at once (the files in <dir>) to <dir>.n.
if [[ -n ${FAKE_MR_PROBE:-} && $endpoint == */related_merge_requests ]]; then
  mkdir -p "$FAKE_MR_PROBE"; : >"$FAKE_MR_PROBE/$$"
  find "$FAKE_MR_PROBE" -type f | wc -l >>"$FAKE_MR_PROBE.n"; sleep 0.3; rm -f "$FAKE_MR_PROBE/$$"
fi
# FAKE_ISSUE_PROBE=<dir>: the issue list calls (state=opened / state=closed) take 0.3 s,
# and each logs how many were running at once to <dir>.n.
if [[ -n ${FAKE_ISSUE_PROBE:-} && $endpoint == */issues\?state=* ]]; then
  mkdir -p "$FAKE_ISSUE_PROBE"; : >"$FAKE_ISSUE_PROBE/$$"; sleep 0.1
  find "$FAKE_ISSUE_PROBE" -type f | wc -l >>"$FAKE_ISSUE_PROBE.n"; sleep 0.2; rm -f "$FAKE_ISSUE_PROBE/$$"
fi
# GraphQL (glab api graphql -f query=...): answered from graphql.json; one with
# "errors" exits 1 as glab does (FAKE_GQL_EXIT0=1: 0 anyway); no fixture: exit 1. Never a write: a
# query that isn't a plain "query" is logged as BAD-GRAPHQL.
if [[ $2 == --hostname && $4 == graphql ]]; then
  [[ $6 == query=query[\(\ ]* && $6 != *mutation* && $6 != *subscription* ]] || echo "BAD-GRAPHQL $*" >>"$FAKE_LOG"
  [[ -f $FAKE_DIR/graphql.json ]] || { echo "glab: GraphQL request failed" >&2; exit 1; }
  cat "$FAKE_DIR/graphql.json"; [[ -z ${FAKE_GQL_EXIT0:-} ]] && jq -e 'has("errors")' "$FAKE_DIR/graphql.json" >/dev/null 2>&1 && exit 1; exit 0
fi
if [[ " $* " != *" --method GET "* ]]; then
  echo "NON-GET $*" >>"$FAKE_LOG"
  if [[ " $* " == *" --method PUT --header Content-Type: application/json --input - "* && $endpoint =~ ^projects/[^/]+/issues/[0-9]+$ ]]; then
    printf 'PUT %s %s\n' "$endpoint" "$(cat)" >>"$FAKE_LOG"
    if [[ ${FAKE_PUT:-ok} != ok ]]; then cat "$FAKE_DIR/put-error.json" 2>/dev/null; exit 1; fi
    cat "$FAKE_DIR/put.json"; exit
  fi
  if [[ " $* " == *" --method POST --header Content-Type: application/json --input - "* && $endpoint =~ ^projects/[^/]+/issues/[0-9]+/notes$ ]]; then
    printf 'POST %s %s\n' "$endpoint" "$(cat)" >>"$FAKE_LOG"
    if [[ ${FAKE_POST:-ok} != ok ]]; then cat "$FAKE_DIR/post-error.json" 2>/dev/null; exit 1; fi
    cat "$FAKE_DIR/post.json"; exit
  fi
  echo "BAD-WRITE $*" >>"$FAKE_LOG"; exit 9
fi
case $endpoint in
  groups/*/boards\?*) f=${endpoint#groups/}; f=group-boards-${f%%/boards\?*} ;;
  projects\?*) f=projects ;;
  */boards\?*) f=boards ;;
  */boards/[0-9]*) f=board ;;
  */labels\?*) f=labels ;;
  */issues\?state=opened*) f=open ;;
  */issues\?state=closed*) f=closed ;;
  */issues/*/notes\?*) f=notes ;;
  */issues/*/related_merge_requests) f=${endpoint%/related_merge_requests}; f=related-${f##*/} ;;
  *merge_requests\?scope=reviews_for_me*) f=mrs-review ;;
  *merge_requests\?scope=created_by_me*) f=mrs-mine ;;
  projects/*/merge_requests/[0-9]*/reviewers) f=${endpoint%/reviewers}; f=reviewers-${f##*/} ;;
  projects/*/merge_requests/[0-9]*) f=mr-${endpoint##*/} ;;
  */issues/*) f=issue ;;
  user) f=user ;;
  personal_access_tokens/self) f=token-self ;;
  projects/*/*) exit 1 ;;
  projects/*) f=project ;;
  *) exit 1 ;;
esac
[[ -f $FAKE_DIR/$f.json ]] || exit 1
cat "$FAKE_DIR/$f.json"
